---
import type { Settings } from '../lib/settings';

interface Props {
  settings: Settings;
}

const { settings } = Astro.props;
const socials = [
  { name: 'Telegram', url: settings.telegramUrl },
  { name: 'ВКонтакте', url: settings.vkUrl },
];
---

<footer class="footer">
  <div class="footer__top shell">
    <a class="footer__brand" href="#top">
      <span class="footer__brand-name"><span>Терруар</span><span>Чёрного моря</span></span>
      <span class="footer__brand-note">Коллекция авторских вин</span>
    </a>
    <p>Коллекция авторских вин,<br />в которой место становится вкусом.</p>
    <nav aria-label="Навигация в подвале">
      <a href="#terroirs">Терруары</a>
      <a href="#wines">Коллекция</a>
      <a href="#science">Методология</a>
      <a href="#about">О проекте</a>
      <a href="#journal">Блог</a>
      <a href="#buy">Где купить</a>
    </nav>
  </div>

  <div class="footer__contacts shell" id="contacts">
    <div><span>Общие вопросы</span><a href={'mailto:' + settings.contactEmail}>{settings.contactEmail}</a></div>
    <div><span>Ресторанам и винотекам</span><a href={'mailto:' + settings.partnersEmail}>{settings.partnersEmail}</a></div>
    <div>
      <span>Социальные сети</span>
      <p>
        {socials.map((social, index) => (
          <>
            {index > 0 && ' · '}
            {social.url ? <a href={social.url} target="_blank" rel="noopener">{social.name}</a> : social.name}
          </>
        ))}
      </p>
    </div>
    <strong>18+</strong>
  </div>

  <div class="footer__bottom shell">
    <p>© 2026 Терруар Чёрного моря</p>
    <div><a href="#">Политика конфиденциальности</a><a href="#">Правовая информация</a></div>
    <p>Чрезмерное употребление алкоголя вредит вашему здоровью.</p>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 30;
    padding: clamp(4rem, 8vw, 8rem) 0 1.5rem;
    background: var(--ink);
    color: var(--chalk);
  }

  .footer__top {
    display: grid;
    align-items: start;
    grid-template-columns: minmax(25rem, 1.2fr) minmax(18rem, 0.72fr) minmax(13rem, 0.62fr);
    gap: clamp(2rem, 6vw, 7rem);
    padding-bottom: clamp(4rem, 8vw, 8rem);
  }

  .footer__brand {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 0.7rem;
  }

  .footer__brand-name {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 3.15vw, 3.8rem);
    letter-spacing: -0.045em;
    line-height: 1.08;
    white-space: nowrap;
  }

  .footer__brand-note {
    color: rgba(247, 243, 234, 0.5);
    font-size: 0.61rem;
    font-weight: 540;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .footer__top > p {
    color: rgba(247, 243, 234, 0.6);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2vw, 2.3rem);
    line-height: 1.35;
  }

  .footer nav {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
  }

  .footer nav a {
    width: 100%;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line-light);
    font-size: 0.68rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .footer__contacts {
    display: grid;
    align-items: end;
    grid-template-columns: repeat(3, 1fr) auto;
    gap: 1.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--line-light);
    border-bottom: 1px solid var(--line-light);
  }

  .footer__contacts > div span {
    display: block;
    margin-bottom: 0.35rem;
    color: rgba(247, 243, 234, 0.5);
    font-size: 0.55rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .footer__contacts > div a,
  .footer__contacts > div p {
    margin: 0;
    font-size: 0.8rem;
  }

  .footer__contacts > div a {
    overflow-wrap: anywhere;
    transition: color 300ms ease;
  }

  .footer__contacts > div a:hover {
    color: #d8a58f;
  }

  .footer__contacts strong {
    color: var(--clay);
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 400;
    line-height: 1;
  }

  .footer__bottom {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1.5rem;
    padding-top: 1.5rem;
    color: rgba(247, 243, 234, 0.5);
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer__bottom p {
    margin: 0;
  }

  .footer__bottom p:last-child {
    text-align: right;
  }

  .footer__bottom div {
    display: flex;
    gap: 1.2rem;
  }

  .footer__bottom a {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
  }

  @media (max-width: 820px) {
    .footer__top {
      grid-template-columns: 1fr;
    }

    .footer__brand-name {
      font-size: clamp(2rem, 8.5vw, 3rem);
      white-space: normal;
    }

    .footer__contacts {
      grid-template-columns: 1fr 1fr;
    }

    .footer__bottom {
      grid-template-columns: 1fr;
    }

    .footer__bottom p:last-child {
      text-align: left;
    }

    .footer__bottom div {
      flex-direction: column;
      gap: 0.6rem;
    }
  }

  @media (max-width: 520px) {
    .footer__contacts {
      grid-template-columns: 1fr;
    }
  }
</style>
