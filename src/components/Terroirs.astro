---
import UploadedImage from './UploadedImage.astro';
import type { Terroir } from '../lib/content';

interface Props {
  terroirs: Terroir[];
}

const { terroirs } = Astro.props;
---

<section class="terroirs" id="terroirs" aria-labelledby="terroirs-title">
  <div class="terroirs__header shell">
    <h2 class="section-title" id="terroirs-title" data-reveal><span>Два участка</span><em>Два характера</em></h2>
    <p data-reveal>Терруары раскрываются через сопоставимые наблюдения: положение участка, почву, рельеф, сезон и связанные с местом авторские вина.</p>
  </div>

  <div class="terroirs__cards shell">
    {terroirs.map((terroir, index) => (
      <a class="terroir-card" href="#map" data-reveal aria-label={'Показать терруар «' + terroir.name + '» на карте'}>
        <div class="terroir-card__media">
          <UploadedImage media={terroir.image} sizes="(max-width: 760px) 100vw, 50vw" alt={terroir.imageAlt} />
          <span class="terroir-card__index">{String(index + 1).padStart(2, '0')}</span>
        </div>
        <div class="terroir-card__body">
          <div>
            <h3>{terroir.name}</h3>
            <p>{terroir.description}</p>
          </div>
          <span class="terroir-card__arrow" aria-hidden="true">↗</span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .terroirs { overflow: hidden; padding: clamp(4rem, 6vw, 7rem) 0 var(--section-space); background: var(--limestone); color: var(--ink); }
  .terroirs__header { display: grid; align-items: end; grid-template-columns: 1.25fr minmax(19rem, 0.45fr); gap: clamp(3rem, 7vw, 8rem); }
  .terroirs__header h2 { display: flex; flex-direction: column; gap: 0.12em; margin: 0; line-height: 0.96; }
  .terroirs__header em { color: var(--grape); font-weight: 400; }
  .terroirs__header > p { margin: 0 0 0.55rem; color: rgba(16, 21, 16, 0.66); font-size: clamp(0.96rem, 1.15vw, 1.12rem); }
  .terroirs__cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1rem, 2.4vw, 2.5rem); margin-top: clamp(4rem, 7vw, 7rem); }
  .terroir-card { display: block; min-width: 0; border-top: 1px solid rgba(16, 21, 16, 0.22); padding-top: 0.8rem; }
  .terroir-card__media { position: relative; overflow: hidden; max-height: 31rem; aspect-ratio: 16 / 10; background: var(--forest); }
  .terroir-card__media::after { position: absolute; inset: 0; content: ''; background: linear-gradient(180deg, transparent 62%, rgba(10, 15, 11, 0.45)); pointer-events: none; }
  .terroir-card__media :global(img) { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.82) contrast(1.03); transition: transform 1.15s var(--ease-out), filter 700ms ease; }
  .terroir-card:hover .terroir-card__media :global(img) { transform: scale(1.045); filter: saturate(1) contrast(1.02); }
  .terroir-card__index { position: absolute; z-index: 2; right: 1rem; bottom: 0.8rem; color: rgba(247, 243, 234, 0.86); font-size: 0.66rem; letter-spacing: 0.16em; }
  .terroir-card__body { display: grid; grid-template-columns: 1fr auto; gap: 1.5rem; padding: 1.5rem 0 0.5rem; }
  .terroir-card h3 { margin: 0; font-family: var(--font-display); font-size: clamp(2.25rem, 3.5vw, 4rem); font-weight: 400; letter-spacing: -0.045em; line-height: 1; }
  .terroir-card p { max-width: 34rem; margin: 1rem 0 0; color: rgba(16, 21, 16, 0.64); font-size: 0.92rem; }
  .terroir-card__arrow { display: grid; width: 3.3rem; height: 3.3rem; place-items: center; border: 1px solid rgba(16, 21, 16, 0.25); border-radius: 50%; font-size: 1.1rem; transition: transform 600ms var(--ease-out), color 300ms ease, background 300ms ease; }
  .terroir-card:hover .terroir-card__arrow { background: var(--ink); color: var(--chalk); transform: translate(0.25rem, -0.25rem); }
  @media (max-width: 860px) { .terroirs__header { grid-template-columns: 1fr; gap: 2rem; } .terroirs__header > p { max-width: 37rem; } }
  @media (max-width: 700px) { .terroirs__cards { grid-template-columns: 1fr; gap: 3.5rem; } .terroir-card__media { max-height: none; aspect-ratio: 4 / 3; } .terroir-card__arrow { width: 3rem; height: 3rem; } }
</style>
