---
import { Image } from 'astro:assets';
import poster from '../assets/video-sunset.png';
import grapesImage from '../assets/wine-grapes-hand.png';
import pourImage from '../assets/wine-pour-glass.png';
import type { Settings } from '../lib/settings';

interface Props {
  settings: Settings;
}

const { settings } = Astro.props;
const manifestoBefore = Array.from(settings.manifestoBefore + ' ');
const manifestoAccent = Array.from(settings.manifestoAccent);
const manifestoAfter = Array.from(' ' + settings.manifestoAfter);
const manifestoLabel = [...manifestoBefore, ...manifestoAccent, ...manifestoAfter].join('');
---

<section class="video-story" id="top" data-video-story aria-label="Введение в проект">
  <div class="video-story__stage" data-video-stage data-phase="hero">
    <video
      class="video-story__media"
      data-story-video
      muted
      playsinline
      loop
      preload="auto"
      poster={poster.src}
      tabindex="-1"
      aria-hidden="true"
    >
      <source src="/media/hero-vineyards.mp4" type="video/mp4" />
    </video>
    <div class="video-story__scrim"></div>

    <div class="video-story__hero shell" data-hero-copy>
      <div class="video-story__headline">
        <div class="video-story__copy">
          <div class="video-story__title-group">
            <h1 class="display-title" tabindex="-1" data-hero-primary>{settings.heroTitle}<br /><em>{settings.heroTitleAccent}</em></h1>
          </div>
          <div class="video-story__intro">
            <p>{settings.heroLead}</p>
            <div class="video-story__actions">
              <a class="text-link" href="#wines">Исследовать коллекцию</a>
              <a class="video-story__secondary" href="#about">О проекте</a>
            </div>
          </div>
        </div>
        <div class="video-story__portraits" aria-label="Виноград и авторское вино">
          <figure class="video-story__portrait video-story__portrait--grapes">
            <Image src={grapesImage} widths={[320, 480, 640]} sizes="(max-width: 720px) 22vw, 15rem" format="webp" quality={84} alt="Ручной сбор винограда" />
          </figure>
          <figure class="video-story__portrait video-story__portrait--wine">
            <Image src={pourImage} widths={[320, 480, 640]} sizes="(max-width: 720px) 22vw, 15rem" format="webp" quality={84} alt="Авторское вино в бокале" />
          </figure>
        </div>
      </div>
      <div class="video-story__scroll" aria-hidden="true">
        <span>Смотреть историю</span>
        <i></i>
      </div>
    </div>

    <div class="video-story__manifesto shell" id="about" data-story-manifesto>
      <p class="video-story__manifesto-text" aria-label={manifestoLabel}>
        <span aria-hidden="true">
          {manifestoBefore.map((char) => <span class="type-char" data-type-char>{char}</span>)}
          <em>{manifestoAccent.map((char) => <span class="type-char" data-type-char>{char}</span>)}</em>
          {manifestoAfter.map((char) => <span class="type-char" data-type-char>{char}</span>)}
        </span>
      </p>
    </div>
  </div>
</section>

<script>
  const story = document.querySelector<HTMLElement>('[data-video-story]');
  const stage = story?.querySelector<HTMLElement>('[data-video-stage]');
  const video = story?.querySelector<HTMLVideoElement>('[data-story-video]');
  const typeChars = [...(story?.querySelectorAll<HTMLElement>('[data-type-char]') || [])];
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let ticking = false;
  let lastTyped = -1;

  const renderTyping = (progress: number) => {
    const typingProgress = Math.min(1, Math.max(0, (progress - 0.48) / 0.36));
    const typed = Math.floor(typingProgress * typeChars.length);
    if (typed === lastTyped) return;
    typeChars.forEach((char, index) => {
      char.classList.toggle('is-typed', index < typed);
    });
    lastTyped = typed;
  };

  const setPhase = (progress: number) => {
    if (!stage) return;
    const clamp = (value: number) => Math.min(1, Math.max(0, value));
    const heroExit = clamp((progress - 0.14) / 0.18);
    const manifestoIn = clamp((progress - 0.38) / 0.14);
    const manifestoExit = clamp((progress - 0.92) / 0.06);
    const phase = progress < 0.34 ? 'hero' : 'manifesto';
    stage.dataset.phase = phase;
    stage.style.setProperty('--story-progress', progress.toFixed(4));
    stage.style.setProperty('--hero-opacity', (1 - heroExit).toFixed(4));
    stage.style.setProperty('--hero-y', `${(-heroExit * 6).toFixed(3)}rem`);
    stage.style.setProperty('--hero-blur', `${(heroExit * 7).toFixed(2)}px`);
    stage.style.setProperty('--manifesto-opacity', (manifestoIn * (1 - manifestoExit)).toFixed(4));
    stage.style.setProperty('--manifesto-y', `${((1 - manifestoIn) * 4 - manifestoExit * 3.5).toFixed(3)}rem`);
    stage.style.setProperty('--manifesto-blur', `${((1 - manifestoIn) * 7 + manifestoExit * 5).toFixed(2)}px`);
    stage.style.setProperty('--story-exit', manifestoExit.toFixed(4));
    renderTyping(progress);
  };

  const update = () => {
    ticking = false;
    if (!story || reduceMotion.matches) return;
    const rect = story.getBoundingClientRect();
    const distance = Math.max(1, story.offsetHeight - window.innerHeight);
    setPhase(Math.min(1, Math.max(0, -rect.top / distance)));
  };

  const requestUpdate = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(update);
  };

  const managePlayback = () => {
    if (!video) return;
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
    if (reduceMotion.matches || saveData || document.documentElement.classList.contains('age-locked')) {
      video.pause();
      return;
    }
    video.play().catch(() => undefined);
  };

  const revealHero = () => stage?.classList.add('is-ready');

  const observer = new IntersectionObserver(([entry]) => {
    if (!video) return;
    if (entry.isIntersecting) managePlayback(); else video.pause();
  }, { rootMargin: '20% 0px', threshold: 0.01 });

  if (story) observer.observe(story);
  window.addEventListener('scroll', requestUpdate, { passive: true });
  window.addEventListener('resize', requestUpdate, { passive: true });
  window.addEventListener('terroir:age-verified', managePlayback);
  window.addEventListener('terroir:age-verified', revealHero);
  document.addEventListener('visibilitychange', () => document.hidden ? video?.pause() : managePlayback());
  reduceMotion.addEventListener('change', () => { managePlayback(); requestUpdate(); });
  requestAnimationFrame(() => {
    if (!document.documentElement.classList.contains('age-locked')) revealHero();
  });
  requestUpdate();
</script>

<style>
  .video-story {
    position: relative;
    height: 540svh;
    background: var(--ink);
  }

  .video-story__stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }

  .video-story__media,
  .video-story__scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .video-story__media {
    z-index: -3;
    object-fit: cover;
    filter: saturate(0.72) contrast(1.05) brightness(0.86);
    transform: scale(calc(1.035 + var(--story-progress, 0) * 0.025));
    opacity: calc(1 - var(--story-exit, 0) * 0.48);
    transition: filter 900ms ease, opacity 280ms linear;
  }

  .video-story__scrim {
    z-index: -2;
    background:
      linear-gradient(90deg, rgba(8, 12, 8, 0.76) 0%, rgba(8, 12, 8, 0.28) 52%, rgba(8, 12, 8, 0.25) 100%),
      linear-gradient(0deg, rgba(8, 12, 8, 0.92) 0%, transparent 52%, rgba(8, 12, 8, 0.22) 100%);
    transition: background 800ms ease;
  }

  .video-story__hero,
  .video-story__manifesto {
    position: absolute;
    inset: 0;
    will-change: opacity, filter, transform;
  }

  .video-story__hero {
    display: flex;
    align-items: flex-end;
    padding-top: 8rem;
    padding-bottom: clamp(2.5rem, 6vh, 5rem);
    opacity: var(--hero-opacity, 1);
    filter: blur(var(--hero-blur, 0));
    transform: translateY(var(--hero-y, 0));
  }

  .video-story__title-group,
  .video-story__intro > p,
  .video-story__actions,
  .video-story__portraits {
    opacity: 0;
    transform: translateY(3rem);
    transition: opacity 1100ms var(--ease-out), transform 1300ms var(--ease-out);
  }

  .video-story__stage.is-ready :is(.video-story__title-group, .video-story__intro > p, .video-story__actions, .video-story__portraits) {
    opacity: 1;
    transform: translateY(0);
  }

  .video-story__stage.is-ready .video-story__intro > p { transition-delay: 170ms; }
  .video-story__stage.is-ready .video-story__actions { transition-delay: 300ms; }
  .video-story__stage.is-ready .video-story__portraits { transition-delay: 210ms; }

  .video-story__headline {
    --portrait-size: clamp(12rem, 16.5vw, 18rem);
    --portrait-gap: 0.75rem;
    display: grid;
    width: 100%;
    align-items: end;
    grid-template-columns: minmax(0, 1fr) calc(var(--portrait-size) * 2 + var(--portrait-gap));
    gap: clamp(2.5rem, 5vw, 6rem);
  }

  .video-story__copy,
  .video-story__title-group {
    min-width: 0;
  }

  .video-story h1 {
    margin: 0;
    color: var(--chalk);
    font-size: clamp(3.8rem, 7.2vw, 7.8rem);
    letter-spacing: -0.055em;
    line-height: 0.92;
    text-transform: uppercase;
  }

  .video-story h1 em {
    color: var(--limestone);
    font-weight: 400;
  }

  .video-story__intro {
    max-width: 36rem;
    margin-top: clamp(1.7rem, 3vh, 2.6rem);
  }

  .video-story__intro > p {
    max-width: 35rem;
    margin: 0 0 1.5rem;
    color: rgba(247, 243, 234, 0.8);
    font-size: clamp(0.92rem, 1.08vw, 1.08rem);
    line-height: 1.55;
  }

  .video-story__portraits {
    position: relative;
    width: calc(var(--portrait-size) * 2 + var(--portrait-gap));
    height: var(--portrait-size);
    align-self: end;
  }

  .video-story__portrait {
    position: absolute;
    bottom: 0;
    width: var(--portrait-size);
    height: var(--portrait-size);
    margin: 0;
    overflow: hidden;
    background: var(--forest);
    isolation: isolate;
    transition: height 950ms var(--ease-out), box-shadow 700ms ease;
  }

  .video-story__portrait--grapes { left: 0; }
  .video-story__portrait--wine { right: 0; }

  .video-story__portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.82) contrast(1.03);
    transform: scale(1.002);
    transition: transform 1200ms var(--ease-out), filter 700ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .video-story__portrait:hover {
      height: calc(var(--portrait-size) * 5 / 3);
      z-index: 2;
      box-shadow: 0 1.4rem 3.8rem rgba(0, 0, 0, 0.28);
    }

    .video-story__portrait:hover :global(img) {
      filter: saturate(1) contrast(1);
      transform: scale(1.035);
    }
  }

  .video-story__actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .video-story__secondary {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: rgba(247, 243, 234, 0.68);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .video-story__scroll {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(2.5rem, 6vh, 5rem);
    display: none;
    align-items: center;
    gap: 0.8rem;
    color: rgba(247, 243, 234, 0.6);
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .video-story__scroll i {
    position: relative;
    width: 1px;
    height: 2.8rem;
    overflow: hidden;
    background: rgba(247, 243, 234, 0.25);
  }

  .video-story__scroll i::after {
    position: absolute;
    inset: 0;
    content: '';
    transform: translateY(-100%);
    background: var(--clay);
    animation: scroll-cue 2s var(--ease-out) infinite;
  }

  .video-story__manifesto em {
    color: var(--clay);
    font-weight: 400;
  }

  .video-story__manifesto {
    display: flex;
    visibility: hidden;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transform: translateY(2.5rem);
    text-align: center;
  }

  .video-story__manifesto-text {
    max-width: min(78rem, 88vw);
    margin: 0 auto;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 4.25vw, 4.9rem);
    letter-spacing: -0.045em;
    line-height: 1.13;
  }

  .type-char {
    position: relative;
    opacity: 0;
    transition: opacity 100ms linear;
  }

  .type-char.is-typed {
    opacity: 1;
  }

  .video-story__stage[data-phase='manifesto'] .video-story__hero {
    pointer-events: none;
  }

  .video-story__manifesto {
    visibility: visible;
    opacity: var(--manifesto-opacity, 0);
    filter: blur(var(--manifesto-blur, 7px));
    transform: translateY(var(--manifesto-y, 4rem));
  }

  .video-story__stage[data-phase='manifesto'] .video-story__scrim {
    background: rgba(8, 12, 8, calc(0.58 + var(--story-exit, 0) * 0.34));
  }

  @keyframes scroll-cue {
    0% { transform: translateY(-100%); }
    55%, 100% { transform: translateY(100%); }
  }

  @media (max-width: 900px) {
    .video-story__headline {
      --portrait-size: clamp(8.5rem, 19vw, 11rem);
      gap: clamp(1.5rem, 5vw, 3.5rem);
    }

    .video-story__intro {
      max-width: 31rem;
    }

  }

  @media (max-width: 720px) {
    .video-story {
      height: 500svh;
    }

    .video-story__media {
      object-position: 62% center;
    }

    .video-story__hero {
      padding-bottom: max(1.6rem, env(safe-area-inset-bottom));
    }

    .video-story h1 {
      font-size: clamp(2.65rem, 11vw, 4.8rem);
    }

    .video-story__intro > p {
      max-width: 24rem;
      margin-bottom: 1rem;
      font-size: 0.84rem;
    }

    .video-story__actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.3rem;
    }

    .video-story__secondary {
      min-height: 2.5rem;
    }

    .video-story__manifesto-text {
      font-size: clamp(2rem, 9.5vw, 3.6rem);
    }

  }

  @media (max-width: 520px) {
    .video-story__headline {
      --portrait-size: clamp(4.9rem, 21vw, 6.5rem);
      position: relative;
      display: block;
    }

    .video-story__title-group {
      padding-right: calc(var(--portrait-size) * 2 + var(--portrait-gap) + 1rem);
    }

    .video-story h1 {
      font-size: clamp(2.35rem, 10.7vw, 3.4rem);
      line-height: 0.9;
    }

    .video-story__intro {
      margin-top: 1.25rem;
    }

    .video-story__portraits {
      position: absolute;
      top: 0;
      right: 0;
    }

    .video-story__actions {
      gap: 0.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .video-story {
      height: auto;
    }

    .video-story__stage {
      position: relative;
      height: auto;
      min-height: 100svh;
      overflow: visible;
      background: var(--ink) url('../assets/video-sunset.png') center / cover no-repeat;
    }

    .video-story__media,
    .video-story__scroll {
      display: none;
    }

    .video-story__portrait,
    .video-story__portrait:hover {
      height: var(--portrait-size);
      box-shadow: none;
    }

    .video-story__hero,
    .video-story__manifesto {
      position: relative;
      inset: auto;
      min-height: 100svh;
      opacity: 1 !important;
      visibility: visible !important;
      transform: none !important;
    }

    .type-char {
      opacity: 1;
      border-right: 0;
    }
  }
</style>
