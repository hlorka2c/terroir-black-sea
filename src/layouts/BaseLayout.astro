---
import '@fontsource/prata/cyrillic-400.css';
import '@fontsource/prata/latin-400.css';
import '@fontsource-variable/commissioner/wght.css';
import '../styles/global.css';
import ogImage from '../assets/video-vineyard-wide.png';

interface Props {
  title?: string;
  description?: string;
  /** Link preview image path; falls back to the bundled vineyard photo. */
  image?: string;
}

const {
  title = 'Терруар Чёрного моря — коллекция авторских вин',
  description = 'Коллекция авторских вин, в которой почва, рельеф, свет, ветер и близость моря становятся характером.',
  image,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image ?? ogImage.src, Astro.site);
---

<!doctype html>
<html lang="ru" class="age-pending">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#101510" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const verified = localStorage.getItem('terroir-age-v1') === 'verified';
          document.documentElement.classList.toggle('age-verified', verified);
          document.documentElement.classList.toggle('age-locked', !verified);
        } catch {
          document.documentElement.classList.add('age-locked');
        }
        document.documentElement.classList.remove('age-pending');
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
